{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 계정 고정 — main/wrangler.jsonc와 같은 계정이어야 D1·KV·R2를 공유한다 (netkjy@gmail.com's Account)
  "account_id": "58340c4743dcda7f81b6d11117eb4433",
  "name": "keepup-site",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-06-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // 커스텀 도메인 — 신규 브랜드 log.keywordream.com을 기본으로, 기존 keepup은 호환 유지(앱 v1.1.0 링크 보존)
  "routes": [
    { "pattern": "log.keywordream.com", "custom_domain": true },
    { "pattern": "keepup.keywordream.com", "custom_domain": true }
  ],
  // ⚠️ D1/KV는 main(keywordream-main)과 '같은 리소스'를 바인딩한다 — 회원/세션 공유(SSO)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "keywordream-db",
      "database_id": "6b4b480a-5403-41a5-984b-fff16b9dc3f1"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "c117befb681c47459cfae095489a1253"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      // TODO(SETUP.md 2단계): `wrangler r2 bucket create keepup-media` (결제수단 등록 필요, 10GB까지 무료)
      "bucket_name": "keepup-media"
    }
  ],
  "vars": {
    "SITE_URL": "https://log.keywordream.com",
    // 로그인 페이지가 있는 메인 사이트 (SSO 진입점)
    "MAIN_URL": "https://keywordream.com",
    // 로그아웃 시 .keywordream.com 쿠키를 지우기 위해 main과 동일하게 설정
    "COOKIE_DOMAIN": ".keywordream.com"
  }
}
